# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=openbridge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openbridge

# ── API ───────────────────────────────────────────────────────
PORT=3001
DATABASE_URL=postgres://openbridge:change-me@db:5432/openbridge
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=12h

# Optional override for the base URL used to build webhook URLs shown in dashboards.
# Leave unset to auto-derive it from the Host header the admin uses to open the
# dashboard (recommended). If you set it, use a hostname/IP reachable FROM your
# OpenWA instance — NOT localhost, which points at OpenWA itself. Also note OpenWA
# refuses to deliver webhooks to private hosts unless they are allowlisted in its
# SSRF_ALLOWED_HOSTS.
# WEBHOOK_BASE=http://192.168.1.50:3001

# LLM gateway (shared infra inside compose)
OMNIROUTE_BASE_URL=http://omniroute:20128

# Bootstrap admin (created on first boot if it doesn't exist)
ADMIN_EMAIL=admin@openbridge.local
ADMIN_PASSWORD=change-me-admin
